# ==========================================
# SyncSphere AI - Environment Variables
# ==========================================

# ------------------------------------------
# Google Firebase Configuration
# ------------------------------------------
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="syncsphere-ai-463611.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="indigo-coder-463611-g5"
VITE_FIREBASE_STORAGE_BUCKET="syncsphere-ai-463611.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# ------------------------------------------
# Google Gemini AI Integration
# ------------------------------------------
VITE_GEMINI_API_KEY="your-gemini-api-key"
VITE_GEMINI_MODEL="gemini-1.5-pro"

# ------------------------------------------
# Google Cloud Storage (For Exports)
# ------------------------------------------
VITE_GCP_STORAGE_BUCKET="syncsphere-exports"

# ------------------------------------------
# Application Configuration
# ------------------------------------------
VITE_APP_URL="http://localhost:5173"
NODE_ENV="development"
